# Use as: cp .env.gb200.example .env.gb200
# Then run GB200 recipes with: just --dotenv-filename .env.gb200 <recipe>
# Put KUBECONFIG and GB200_SSH_KEY machine-local paths only in .env.gb200.
GB200_BASTION=REPLACE_ME
GB200_SSH_USER=REPLACE_ME
KUBE_CONTEXT=default
NAMESPACE=vllm
URL=http://lwilkinson-glm-epp:80
MODEL=zai-org/GLM-5.2-FP8
CONTEXT_PROFILE=limited
AIPERF_MAX_CONTEXT_LENGTH=142000
AGENTX_DATASET=semianalysis_cc_traces_weka_062126
TOKENIZER=zai-org/GLM-5.2-FP8
MODEL_REVISION=ba978f7d347eaf65d22f1a86833408afdb953541

MANIFESTO_ROOT=../llm-manifesto
MANIFESTO_USER=lwilkinson
MANIFESTO_CLUSTER=oci-gb200
MANIFESTO_SPEC=glm-5.2/gb200/p1-pcp4dcp4ep-d1-dp4ep-dspark
# This ve worktree lives on lustre-pvc-vllm and was built for Linux arm64 / SM100.
VLLM_ENV=/mnt/lustre/lwilkinson/vdptest/frankenstein-prefiller-lucas-dcp
VLLM_IMAGE=nvcr.io/nvidia/pytorch:25.08-py3

ROUTER_RELEASE=lwilkinson-glm
ROUTER_CHART_VERSION=v0.9.0
ROUTER_PROBE_PORT=33081
IMAGE_PULL_SECRET=tms-llmd-reader-pull-secret
KUEUE_QUEUE=

SWEEP_SPECS="glm-5.2/gb200/p1-pcp4dcp4ep-d1-dp4ep-dspark"
SWEEP_CONCURRENCIES="1 8 32 64"

RESULTS_PVC=lustre-pvc-vllm
RESULTS_PREFIX=glm52-agentx
AIPERF_IMAGE=quay.io/rh-ee-robshaw/aiperf:agentx-v0
# This image is amd64-only; the GB200 cluster has dedicated amd64 CPU workers.
AIPERF_ARCH=amd64
# Lustre is unavailable on those workers; copy artifacts from the completed pod.
AIPERF_RESULTS_MODE=pod
CONCURRENCY=1
DURATION_SECONDS=1800
RANDOM_SEED=20260827

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
GRAFANA_LOCAL_PORT=3000
ACCURACY_CHECK=0
ACCURACY_LIMIT=200
