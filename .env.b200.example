# Use as: cp .env.b200.example .env.b200
# Put the machine-local KUBECONFIG path only in the ignored .env.b200 copy.
KUBE_CONTEXT=gke-context
NAMESPACE=default
URL=http://REPLACE_ME-epp:80
MODEL=glm-agentx
CONTEXT_PROFILE=limited
AIPERF_MAX_CONTEXT_LENGTH=142000
AGENTX_DATASET=semianalysis_cc_traces_weka_062126
TOKENIZER=zai-org/GLM-5.3
MODEL_REVISION=30333038ada1f1dacb294a93270305a890b50c14

MANIFESTO_ROOT=../llm-manifesto
# A dedicated owner prevents sweep teardown from selecting other sessions'
# Manifesto model servers in the shared default namespace.
B200_OWNER_PREFIX=REPLACE_ME
B200_ROUTER_PREFIX=REPLACE_ME
MANIFESTO_USER=REPLACE_ME
MANIFESTO_CLUSTER=gke-b200
MANIFESTO_SPEC=glm-5.3/b200/p1-pcp8ep-d1-dp8ep-mtp-agentx
MANIFESTO_LOG_ROOT=/var/cache/vllm-logs
VLLM_ENV=
VLLM_IMAGE=

ROUTER_RELEASE=REPLACE_ME
ROUTER_CHART_VERSION=v0.9.0
ROUTER_PROBE_PORT=33101
MODEL_READY_TIMEOUT_SECONDS=7200
KUEUE_QUEUE=

SWEEP_SPECS="glm-5.3/b200/p1-pcp8ep-d1-dp8ep-mtp-agentx glm-5.3/b200/p1-pcp8dcp8ep-d1-dp8ep-mtp-a2a-agentx glm-5.3/b200/p1-tp8ep-d1-dp8ep-mtp-agentx"
SWEEP_CONCURRENCIES="1 2 4 8"

# B200 has no shared result volume; direct-run copies artifacts from each
# completed benchmark pod.
RESULTS_PREFIX=glm53-b200-prefiller-comparison
AIPERF_IMAGE=quay.io/rh-ee-robshaw/aiperf:agentx-v0
AIPERF_ARCH=amd64
AIPERF_RESULTS_MODE=pod
LOCAL_RESULTS_ROOT=results/.artifacts

CONCURRENCY=1
DURATION_SECONDS=1800
RANDOM_SEED=20260827
RESET_PREFIX_CACHES=true
ACCURACY_CHECK=0
