KUBE_CONTEXT=REPLACE_ME
NAMESPACE=REPLACE_ME
# In-cluster URL of the llm-d router service (<ROUTER_RELEASE>-epp:80).
URL=http://glm-epp:80
MODEL=zai-org/GLM-5.2-FP8
CONTEXT_PROFILE=limited
AIPERF_MAX_CONTEXT_LENGTH=142000
AGENTX_DATASET=semianalysis_cc_traces_weka_062126
TOKENIZER=zai-org/GLM-5.2-FP8
MODEL_REVISION=ba978f7d347eaf65d22f1a86833408afdb953541

# llm-manifesto: sibling checkout, catalog lives in ./manifesto (clusters/, models/).
MANIFESTO_ROOT=../llm-manifesto
MANIFESTO_USER=REPLACE_ME
MANIFESTO_CLUSTER=coreweave-h200
MANIFESTO_SPEC=glm-5.2/h200/p1-pcp8dcp8ep-d1-dp8ep-dspark
# vLLM build under test: a `ve` env / clone with .venv on the workspace PVC (just envs).
VLLM_ENV=/workspace/vdptest/vllm-main
# Toolchain image the env runs in (built from vllm-envs/Dockerfile); blank = spec default.
VLLM_IMAGE=

# llm-d standalone router Helm release (deploy/router-values.yaml).
ROUTER_RELEASE=glm
ROUTER_CHART_VERSION=v0.9.0
IMAGE_PULL_SECRET=quay-push
# Kueue LocalQueue for model pods and aiperf Jobs (empty = no Kueue). Create with: just kueue install
KUEUE_QUEUE=

# Sweeps: just sweep <name> [specs...]
SWEEP_SPECS="glm-5.2/h200/p1-pcp8dcp8ep-d1-dp8ep-dspark"
SWEEP_CONCURRENCIES="1 8 32 64"
# agentx: long final validation; lmsys: fast OpenHands Pareto points at 1,2,4,8.
BENCHMARK_WORKLOAD=agentx
LMSYS_NUMBERS="4 8 8 16"
LMSYS_PARALLELS="1 2 4 8"
LMSYS_LOCAL_PORT=18080
CLIENT_PYTHON=python3.12

RESULTS_PVC=REPLACE_ME
RESULTS_PREFIX=glm52-agentx
AIPERF_IMAGE=quay.io/rh-ee-robshaw/aiperf:agentx-v0
AIPERF_ARCH=amd64

CONCURRENCY=1
DURATION_SECONDS=1800
RANDOM_SEED=20260827

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
GRAFANA_LOCAL_PORT=3000
# Run scripts/accuracy-check.sh (lm_eval gsm8k) after each sweep config's benchmarks
ACCURACY_CHECK=0
ACCURACY_LIMIT=200
