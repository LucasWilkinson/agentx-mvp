KUBE_CONTEXT=REPLACE_ME
NAMESPACE=REPLACE_ME
# In-cluster URL of the llm-d router service (<ROUTER_RELEASE>-epp:80).
URL=http://glm-epp:80
MODEL=zai-org/GLM-5.2-FP8
MAX_CONTEXT_LENGTH=142000

# llm-manifesto: sibling checkout, catalog lives in ./manifesto (clusters/, models/).
MANIFESTO_ROOT=../llm-manifesto
MANIFESTO_USER=REPLACE_ME
MANIFESTO_CLUSTER=coreweave-h200
MANIFESTO_SPEC=glm-5.2/p1-tp8-d1-dp8ep
# vLLM build under test: a `ve` env / clone with .venv on the workspace PVC (just envs).
VLLM_ENV=/workspace/vdptest/vllm-main
# Toolchain image the env runs in (built from vllm-envs/Dockerfile); blank = spec default.
VLLM_IMAGE=

# llm-d standalone router Helm release (deploy/router-values.yaml).
ROUTER_RELEASE=glm
ROUTER_CHART_VERSION=v0.9.0
IMAGE_PULL_SECRET=quay-push

# Sweeps: just sweep <name> [specs...]
SWEEP_SPECS="glm-5.2/p1-tp8-d1-dp8ep glm-5.2/p1-tp8ep-d1-dp8ep"
SWEEP_CONCURRENCIES="16 32 64"

RESULTS_PVC=REPLACE_ME
RESULTS_PREFIX=glm52-agentx
AIPERF_IMAGE=quay.io/rh-ee-robshaw/aiperf:agentx-v0

CONCURRENCY=16
DURATION_SECONDS=300
RANDOM_SEED=42

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
GRAFANA_LOCAL_PORT=3000
